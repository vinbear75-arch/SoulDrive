{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://souldrive.local/schemas/infer_response_v0.1.schema.json",
  "title": "SoulDrive inference response v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "episode_id",
    "intent",
    "slots",
    "aligned_event_ids",
    "conflict_type",
    "clarification_required",
    "action",
    "confidence",
    "latency_ms"
  ],
  "properties": {
    "schema_version": {"const": "souldrive_infer_response_v0.1"},
    "episode_id": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "slots": {"type": "object"},
    "target_id": {"type": ["string", "null"]},
    "aligned_event_ids": {"type": "array", "items": {"type": "string"}},
    "conflict_type": {"type": "string"},
    "clarification_required": {"type": "boolean"},
    "action": {"type": "string"},
    "response": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "latency_ms": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0},
      "required": ["total"]
    },
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "trace_id": {"type": ["string", "null"]}
  }
}
