{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://souldrive.local/schemas/run_manifest_v0.1.schema.json",
  "title": "SoulDrive evaluation run manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "baseline_level",
    "status",
    "repository",
    "environment",
    "inputs",
    "components",
    "outputs",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "souldrive_run_manifest_v0.1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "baseline_level": {"enum": ["B0_CURRENT", "B1_SIMPLE", "B2_STRONG", "CANDIDATE"]},
    "status": {"enum": ["complete", "partial", "failed"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "branch", "tracked_diff_sha256", "untracked_files", "workspace_state_sha256"],
      "properties": {
        "head": {"type": "string"},
        "branch": {"type": "string"},
        "tracked_diff_sha256": {"type": "string"},
        "untracked_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string"}
            }
          }
        },
        "workspace_state_sha256": {"type": "string"}
      }
    },
    "environment": {"type": "object"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "components": {"type": "object"},
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
