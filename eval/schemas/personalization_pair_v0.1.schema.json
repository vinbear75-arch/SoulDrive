{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://souldrive.local/schemas/personalization_pair_v0.1.schema.json",
  "title": "SoulDrive paired personalization evaluation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pair_id",
    "question",
    "evidence_ids",
    "baseline_answer",
    "personalized_answer",
    "expected_facts",
    "expected_profile_markers",
    "forbidden_profile_markers",
    "forbidden_scope_markers"
  ],
  "properties": {
    "schema_version": {"const": "souldrive_personalization_pair_v0.1"},
    "pair_id": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "project_id": {"type": ["string", "null"]},
    "profile_id": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(E|V|A|M)[0-9]+$"}},
    "baseline_answer": {"type": "string"},
    "personalized_answer": {"type": "string"},
    "expected_facts": {"type": "array", "items": {"type": "string"}},
    "expected_profile_markers": {"type": "array", "items": {"type": "string"}},
    "forbidden_profile_markers": {"type": "array", "items": {"type": "string"}},
    "forbidden_scope_markers": {"type": "array", "items": {"type": "string"}}
  }
}
