{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SoulDrive business seed for human review, not evaluation gold",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "review_status", "business_task", "data_kind", "prompt", "source_refs", "setup", "proposed_checks", "gold", "review_notes"],
  "properties": {
    "schema_version": {"const": "souldrive_business_seed_review_v0.1"},
    "id": {"type": "string", "pattern": "^SEED-(RAG|PAPER|EXP|MEM)-[0-9]{3}$"},
    "review_status": {"const": "pending_review"},
    "business_task": {"enum": ["cross_document_synthesis", "paper_review", "experiment_compare", "memory_conflict"]},
    "data_kind": {"enum": ["public_corpus_question", "synthetic_contract_scenario"]},
    "prompt": {"type": "string", "minLength": 8},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "setup": {
      "type": "object",
      "required": ["project_id", "workflow_id", "selected_document_refs"],
      "properties": {
        "project_id": {"const": "review-project-a"},
        "workflow_id": {"enum": [null, "paper_review", "experiment_compare"]},
        "selected_document_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "proposed_checks": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "gold": {"const": null},
    "review_notes": {"type": "string", "minLength": 3}
  }
}
